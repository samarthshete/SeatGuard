# ============================================================================
# TicketBlitz — environment variables
# Copy to `.env` and fill in. Never commit real secrets.
# ============================================================================

# --- REQUIRED: API ----------------------------------------------------------
# PostgreSQL connection string (Neon / Railway / Render Postgres).
DATABASE_URL="postgresql://user:password@host:5432/ticketblitz?sslmode=require"

# Port the API listens on (Render/Heroku inject this automatically).
PORT=3000

# production | development
NODE_ENV=production

# Allowed browser origin(s) for CORS + WebSockets. Comma-separated.
# Set this to your deployed frontend URL (e.g. the Vercel domain).
FRONTEND_URL="https://ticket-blitz.vercel.app"

# REQUIRED in production — secret used to sign JWT auth tokens. The API refuses
# to start in production without it. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-use-a-long-random-string"

# Optional rate-limit tuning (defaults: 100 requests / 1 minute per IP).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW="1 minute"

# --- OPTIONAL: tracing (OpenTelemetry) --------------------------------------
# Tracing is OFF unless ENABLE_TRACING=true AND a collector endpoint is set.
ENABLE_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"
OTEL_SERVICE_NAME="ticket-blitz"
